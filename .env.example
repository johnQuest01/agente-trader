# Copie este arquivo para ".env" (na mesma pasta) e preencha as linhas abaixo.
# O arquivo .env NAO vai para o GitHub (esta no .gitignore).

# ---------- Binance Demo Mode (conta de demonstracao, sem dinheiro real) ----------
#   1. entre em https://demo.binance.com com a sua conta;
#   2. abra "API Key Management" e crie uma chave;
#   3. cole a chave e o segredo aqui.
# NUNCA coloque aqui uma chave da conta de verdade. O programa so fala com
# https://demo-api.binance.com e recusa qualquer outro endereco.
BINANCE_DEMO_KEY=
BINANCE_DEMO_SECRET=

# ---------- IA do agente (API da Anthropic) ----------
# Chave criada em https://platform.claude.com (Console da Anthropic, "API keys").
# Cada mensagem para a IA custa dinheiro de verdade, cobrado na sua conta da Anthropic.
# Sem esta linha preenchida a IA fica desligada e o resto do programa funciona igual.
# A IA tambem precisa da biblioteca oficial: rode "npm install" uma vez nesta pasta.
ANTHROPIC_API_KEY=

# Opcionais (os padroes estao em src/config.js):
# AI_MODEL=claude-opus-5-5        modelo; mais baratos: claude-sonnet-5-5, claude-haiku-5-5
# AI_MAX_USD_PER_DAY=2            teto de gasto estimado por dia, em dolares (0 = sem teto)
